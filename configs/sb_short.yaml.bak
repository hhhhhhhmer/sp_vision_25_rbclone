pattern_cols: 11      # 棋盘格每行的内角点数（格子数-1）
pattern_rows: 8      # 棋盘格每列的内角点数（格子数-1）
square_size_mm: 30   # 棋盘格方块大小（毫米）

# enemy_color: "blue"
# enemy_color: "red"
enemy_color: "auto"

#####-----神经网络参数-----#####
yolo_name: yolov8
classify_model: ../assets/tiny_resnet.onnx
yolo11_model_path: ../assets/yolo11.xml
yolov8_model_path: ../assets/yolov8.xml
yolov5_model_path: ../assets/yolov5.xml
tensorrt_engine_path: ../assets/0708_int8_calib.engine
# tensorrt_engine_path: ../assets/0708_fp16_super.engine
device: CPU
min_confidence: 0.5
use_traditional: true

#####-----ROI-----#####
roi: 
  x: 420
  y: 50
  width: 600
  height: 600

use_roi: false

# #####-----传统方法参数-----#####
threshold: 150
max_angle_error: 45 # degree
min_lightbar_ratio: 1.5
max_lightbar_ratio: 20
min_lightbar_length: 832
min_armor_ratio: 1
max_armor_ratio: 5
max_side_ratio: 1.5
max_rectangular_error: 25 # degree
# min_confidence: 0.8

# rv识别
number_classifier:
  model_path: "../assets/rv_model/mlp.onnx"   # 模型路径 (确保文件存在)
  label_path: "../assets/rv_model/label.txt"  # 标签文件路径
  threshold: 0.5                 # 数字分类阈值
  ignore_classes: ["negative"]   # 忽略的类别

#####-----tracker参数-----#####
min_detect_count: 5
max_temp_lost_count: 11
outpost_max_temp_lost_count: 75


#####-----aimer参数-----##### 12mm
yaw_offset: 0.73 # degree -2.5
pitch_offset: 1.7 # degree 2
far_pitch_offset: 1.7
comming_angle: 60 # degree
leaving_angle: 20 # degree
decision_speed: 8 # rad/s
high_speed_delay_time: 0.015 # s   远 0.25
low_speed_delay_time: 0.015 # s    远 0.25
gimbal_delay: 0.00
shoot_offset: 2

#####-----shooter参数-----#####
first_tolerance: 3 # 近距离射击容差，degree
second_tolerance: 2 # 远距离射击容差，degree          
judge_distance: 2 #距离判断阈值
auto_fire: true # 是否由自瞄控制射击

