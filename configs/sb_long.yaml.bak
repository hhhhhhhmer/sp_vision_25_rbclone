buff_confidence_threshold: 0.7
buff_keypoint_threshold: 0.3
buff_rune_radius_m: 0.700
buff_locked_gate_deg: 25
buff_switch_gate_deg: 10
buff_switch_confirm_frames: 3
buff_locked_lost_max: 6
#####-----buff_aimer参数-----#####
aim_time: 0.150         # s
wait_time: 0.300        # s
command_fire_gap: 0.080 # s
fire_gap_time: 0.700   # s
predict_time: 0.120    # s



